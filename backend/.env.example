PORT=5000
MONGO_URI=mongodb://localhost:27017/event_media_system
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me_too
CORS_ORIGIN=http://localhost:5173
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Media storage driver: "local" (default) or "cloudinary".
# local writes to backend/uploads and needs no account, which matters because
# Cloudinary is not available in every country.
MEDIA_STORAGE=local
# Absolute base URL used to build local media links. Must match the port the
# backend actually binds, since the browser loads these from a different origin.
PUBLIC_BASE_URL=http://localhost:5099

# Cloudinary (https://cloudinary.com) - only needed when MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Free-tier caps are roughly 10MB/image, 100MB/video - keep this conservative
MEDIA_MAX_FILE_SIZE_MB=10
