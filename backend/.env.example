PORT=5000
MONGO_URI=mongodb://localhost:27017/event_media_system
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me_too
CORS_ORIGIN=http://localhost:5173
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary (free tier: https://cloudinary.com) - required for media upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Free-tier caps are roughly 10MB/image, 100MB/video - keep this conservative
MEDIA_MAX_FILE_SIZE_MB=10
